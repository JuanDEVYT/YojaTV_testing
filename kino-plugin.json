{
  "id": "yoja-tv-kino",
  "name": "YojaTV-alpha",
  "version": "8.3.0",
  "apiVersion": 11,
  "entry": "plugin.js",
  "description": "Plugin de YojaTV para Kino TV. Películas de cine en español latino, series y anime. Creado por JuandreXter, YojanderGaming y einer_bg.",
  "author": "JuandreXter, YojanderGaming, einer_bg",
  "homepage": "https://github.com/YojaTV-kino/YojaTV_plugin",
  "browser": "pages",
  "streamHosts": "any",
  "fetchHosts": "any",
  "liveStreamHosts": "any",
  "color": "#FF6B00",
  "debug": true,
  "telemetry": "verbose",
  "panel": {
    "label": "YojaTV",
    "labelEn": "YojaTV",
    "iconFile": "panel-icon.png"
  },
  "settings": [
    {
      "key": "tmdbKey",
      "label": "API Key de TMDB",
      "labelEn": "TMDB API key",
      "type": "password",
      "hint": "Opcional. Gratis en themoviedb.org ▸ Settings ▸ API",
      "hintEn": "Optional. Free at themoviedb.org ▸ Settings ▸ API"
    },
    {
      "key": "tmdbLang",
      "label": "Idioma del catálogo",
      "labelEn": "Catalog language",
      "type": "select",
      "default": "es-MX",
      "options": [
        {
          "value": "es-MX",
          "label": "Español (Latinoamérica)",
          "labelEn": "Spanish (Latin America)"
        },
        {
          "value": "es-ES",
          "label": "Español (España)",
          "labelEn": "Spanish (Spain)"
        },
        {
          "value": "en-US",
          "label": "English",
          "labelEn": "English"
        },
        {
          "value": "pt-BR",
          "label": "Português",
          "labelEn": "Portuguese"
        }
      ]
    },
    {
      "key": "sourceRows",
      "label": "Filas de las fuentes",
      "labelEn": "Source rows",
      "type": "toggle",
      "default": false,
      "hint": "Muestra las filas de cada fuente en Inicio",
      "hintEn": "Shows each source's rows on Home"
    },
    {
      "key": "reportErrors",
      "label": "Enviar reportes de errores",
      "labelEn": "Send error reports",
      "type": "toggle",
      "default": true,
      "hint": "Envía errores y registros a la página de estado, con un ID anónimo",
      "hintEn": "Sends errors and logs to the status page with an anonymous ID"
    },
    {
      "key": "estado",
      "label": "Estado",
      "labelEn": "Status",
      "type": "status"
    },
    {
      "key": "clearCache",
      "label": "Limpiar caché del catálogo",
      "labelEn": "Clear catalog cache",
      "type": "action",
      "confirm": "¿Borrar la caché de TMDB del catálogo?",
      "confirmEn": "Delete the TMDB catalog cache?"
    },
    {
      "key": "testTmdb",
      "label": "Probar conexión con TMDB",
      "labelEn": "Test TMDB connection",
      "type": "action"
    },
    {
      "key": "testReport",
      "label": "Enviar reporte de prueba",
      "labelEn": "Send test report",
      "type": "action"
    },
    {
      "key": "showDeviceId",
      "label": "Ver ID del dispositivo",
      "labelEn": "Show device ID",
      "type": "action"
    }
  ],
  "settingsLayout": [
    {
      "type": "card",
      "title": "Catálogo",
      "titleEn": "Catalog",
      "children": [
        {
          "setting": "tmdbKey"
        },
        {
          "setting": "tmdbLang"
        },
        {
          "setting": "sourceRows"
        }
      ]
    },
    {
      "type": "card",
      "title": "Diagnóstico",
      "titleEn": "Diagnostics",
      "children": [
        {
          "setting": "reportErrors"
        },
        {
          "setting": "estado"
        },
        {
          "setting": "clearCache"
        },
        {
          "setting": "testTmdb"
        },
        {
          "setting": "testReport"
        },
        {
          "setting": "showDeviceId"
        }
      ]
    }
  ],
  "section": {
    "label": "YojaTV",
    "labelEn": "YojaTV"
  },
  "theme": {
    "accent": "#FF6B00",
    "onAccent": "#000000",
    "background": "#0B0F19",
    "surface": "#161D2F",
    "highlight": "#F5F5F5"
  },
  "categories": [
