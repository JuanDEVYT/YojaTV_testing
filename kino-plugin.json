{
  "id": "yoja-tv-kino",
  "name": "YojaTV",
  "version": "5.1.1",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Plugin de YojaTV para Kino TV. Películas de cine en español latino, series y anime. Creado por JuandreXter, YojanderGaming y einer_bg.",
  "author": "JuandreXter, YojanderGaming, einer_bg",
  "homepage": "https://github.com/YojaTV-kino/YojaTV_plugin",
  "browser": "pages",
  "streamHosts": "any",
  "debug": true,
  "telemetry": "verbose",
  "settings": [
    {
      "key": "tmdbKey",
      "label": "API Key de TMDB",
      "type": "password",
      "hint": "Gratis en themoviedb.org ▸ Settings ▸ API"
    },
    {
      "key": "tmdbLang",
      "label": "Idioma del catálogo",
      "type": "select",
      "default": "es-MX",
      "options": [
        {
          "value": "es-MX",
          "label": "Español (Latinoamérica)"
        },
        {
          "value": "es-ES",
          "label": "Español (España)"
        },
        {
          "value": "en-US",
          "label": "English"
        },
        {
          "value": "pt-BR",
          "label": "Português"
        }
      ]
    },
    {
      "key": "sourceRows",
      "label": "Filas de las fuentes",
      "type": "toggle",
      "default": true
    },
    {
      "key": "estado",
      "label": "Estado",
      "type": "status"
    }
  ],
  "section": {
    "label": "YojaTV"
  },
  "theme": {
    "accent": "#FF6B00",
    "onAccent": "#000000",
    "background": "#0B0F19",
    "surface": "#161D2F",
    "highlight": "#F5F5F5"
  },
  "categories": [
    "movies",
    "series",
    "anime"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
